    {
      "id": "claim_c4bcf6763c6742b89463e3caac203cd0",
      "statement": "The normally supplied `JwtServiceAdapter` generates refresh tokens as random UUIDs, but its `extractUserEmail` parses the supplied value as a signed JWS; `AuthService.refresh` invokes that extraction on the stored refresh token after local expiry/revocation checks and before revoking or replacing it, making the shipped refresh path incompatible.",
      "evidence": [
        {
          "resource": "repo://engine-core/src/main/java/com/engine/core/services/AuthService.java#L66-L99",
          "version": "repo-lines-v1:sha256:ab403ee110b2d72acd1c51163f8d86fe2dfae12593aa91ebfc2d6a6a2d5e4c03:"
