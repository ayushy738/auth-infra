    {
      "id": "claim_bd0e9ae3d030407693e64340bf2c8f36",
      "statement": "Core registration rejects an existing email and hashes the password before saving; refresh requires a stored token that is neither expired nor revoked, resolves its user from the token service, revokes the old token, and then issues and saves a replacement token pair; logout blacklists the supplied access token and records an audit event.",
      "evidence": [
        {
          "resource": "repo://engine-core/src/main/java/com/engine/core/services/AuthService.java#L34-L107",
          "version": "repo-lines-v1:sha256:64e92ed51638650673db69d1c5b625398fed8a58230c2b4dffb18eb4ac263f60:"
        }
      ]
    },
    {
