    {
      "id": "claim_a888246d05ea4987af9132e09e268124",
      "statement": "The security chain is stateless, permits configured public paths including `/auth/**` by default, requires authentication otherwise, requires `ADMIN` for `/admin/**`, and installs the JWT filter before username/password authentication.",
