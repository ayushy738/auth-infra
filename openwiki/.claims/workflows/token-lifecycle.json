    },
    {
      "id": "claim_85a8b6d6b7e44c929cda74283a1b860f",
      "statement": "Logout blacklists the exact access-token string for a fixed 15 minutes and emits a `LOGOUT_SUCCESS` audit record, without revoking refresh tokens; the filter consults this blacklist before JWT parsing.",
