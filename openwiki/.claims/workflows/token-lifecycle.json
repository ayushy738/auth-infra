        }
      ]
    },
    {
      "id": "claim_e12a23e9608d48ada815a5d2bbf74d13",
      "statement": "The core refresh flow requires a stored token that is neither expired nor revoked, extracts an email from the presented token to load the user, revokes the old token, and only then generates and saves the replacement pair.",
