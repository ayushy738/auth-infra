    {
      "id": "claim_4d8e862444734e1c86f6e1f25e00d933",
      "statement": "`POST /auth/register` and `POST /auth/refresh` delegate to `AuthService` and return its `AuthResponse`, while the supplied controller has no login or logout mapping even though `AuthService` exposes `login` and `logout` methods.",
      "evidence": [
        {
          "resource": "repo://engine-core/src/main/java/com/engine/core/services/AuthService.java#L34-L107",
          "version": "repo-lines-v1:sha256:64e92ed51638650673db69d1c5b625398fed8a58230c2b4dffb18eb4ac263f60:"
        },
        {
