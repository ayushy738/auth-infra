          "resource": "repo://engine-core/src/main/java/com/engine/core/domain/RefreshToken.java#L5-L26",
          "version": "repo-lines-v1:sha256:692af746fced8a85640b635a2b960620417ab1b2e879c350de40d91c67213155:"
