        }
      ]
    },
    {
      "id": "claim_dccbfd30ae0549c08945baec2bfb1ed9",
      "statement": "Registration rejects an existing email, BCrypt-encodes a new user's password, assigns a random ID and `Role.USER`, persists the user, and then issues an access/refresh pair and persists a refresh record.",
