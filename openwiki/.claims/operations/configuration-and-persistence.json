    {
      "id": "claim_a3d38bff323046579f9de4f694ec34ab",
      "statement": "Neither properties class supplies defaults for `jwtSecret`, `accessExpiration`, or `refreshExpiration`; token signing derives an HMAC key by calling `getBytes()` on the secret and expiration values are added to current time, so missing or invalid configuration is not validated at binding time.",
      "evidence": [
        {
          "resource": "repo://engine-spring-starter/src/main/java/com/engine/starter/config/EngineSecurityProperties.java#L10-L40",
          "version": "repo-lines-v1:sha256:c04d442a71889a6c72e6f423a6a467686950ca2a02d1e948708f3d5c73184e6f:"
