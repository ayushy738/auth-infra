  "claims": [
    {
      "id": "claim_8fd61f93cd0b4f9b9e6c15f01fb6bc3d",
      "statement": "The starter contains two distinct `EngineSecurityProperties` classes, `com.engine.starter.EngineSecurityProperties` and `com.engine.starter.config.EngineSecurityProperties`, each bound to the `engine.security` prefix; the root type is enabled by `EngineAutoConfiguration`, while `SecurityConfig` enables and consumes the config-package type.",
      "evidence": [
        {
          "resource": "repo://engine-spring-starter/src/main/java/com/engine/starter/EngineAutoConfiguration.java#L15-L20",
          "version": "repo-lines-v1:sha256:d02d9cbf01eb2b520db8c7bf194449b62a989b9b365ef4ebebfdf2ea77109d50:"
        },
        {
