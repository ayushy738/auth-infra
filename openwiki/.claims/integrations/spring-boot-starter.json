          "resource": "repo://engine-spring-starter/src/main/java/com/engine/starter/security/JwtAuthenticationFilter.java#L19-L66",
          "version": "repo-lines-v1:sha256:be3e4639b3c9484a72433b7c627fb2083c00501c50d6d82b345623b810a20291:"
