        }
      ]
    },
    {
      "id": "claim_8a98728302004ff08fe6e57b49d85b37",
      "statement": "JWT parsing for email occurs before validation and is not caught in JwtAuthenticationFilter, so malformed or expired bearer-token parsing can escape from the filter rather than simply leaving the request unauthenticated.",
