    {
      "id": "claim_70393cee2c544800886c9e75b48a75fc",
      "statement": "JwtAuthenticationFilter skips absent/non-Bearer and blacklisted tokens; for a nonblacklisted bearer it extracts the email, validates the access token, loads UserDetails, and writes the user's authorities to the SecurityContext before continuing the chain.",
