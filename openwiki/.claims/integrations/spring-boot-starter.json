    {
      "id": "claim_d0eb0e7e0fdd4342a01c164541e8879e",
      "statement": "Spring Boot discovers four imported starter auto-configurations: EngineAutoConfiguration, AuthControllerConfiguration, EngineSecurityBeansConfiguration, and EngineWebSecurityAutoConfiguration; the latter imports SecurityConfig when running as a web application with Spring Security's SecurityFilterChain available.",
