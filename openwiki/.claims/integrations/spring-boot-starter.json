    {
      "id": "claim_22af5e55278746ae804890a46d2159f5",
      "statement": "The effective imported SecurityConfig creates a highest-precedence stateless chain that permits configured public paths, restricts /admin/** to ADMIN, requires authentication otherwise, and inserts JwtAuthenticationFilter before UsernamePasswordAuthenticationFilter.",
